{
  "name": "spanish-learning-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/saas-contracts"
  ],
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "test:missions": "node --test tests/*.test.mjs",
    "firebase:version": "firebase --version",
    "emulators:start": "firebase emulators:start --only auth,firestore,storage --project demo-polish-learning",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-polish-learning \"node --test tests/rules/*.test.mjs\"",
    "test:rules:firestore": "firebase emulators:exec --only firestore --project demo-polish-learning \"node --test tests/rules/messagesCreate.test.mjs tests/rules/forumPostCreate.test.mjs tests/rules/forumReplyCreate.test.mjs tests/rules/forumReportCreate.test.mjs tests/rules/supportTicketCreate.test.mjs tests/rules/selectiveHardeningRegression.test.mjs tests/rules/saasRegression.test.mjs\"",
    "ci:validate:firestore-rules": "node scripts/ci/validate-firestore-rules-ci.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:saas-contracts": "node --test packages/saas-contracts/__tests__/*.test.mjs",
    "pack:saas-contracts:dry-run": "npm pack --workspace @mipymetic/saas-contracts --dry-run"
  },
  "dependencies": {
    "@mipymetic/saas-contracts": "0.13.0",
    "chart.js": "^4.4.9",
    "fastest-levenshtein": "^1.0.16",
    "firebase": "^11.10.0",
    "framer-motion": "^12.6.5",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.0",
    "react-select": "^5.10.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "15.24.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.3",
    "vite": "^6.2.0"
  }
}
